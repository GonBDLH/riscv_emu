// cp_misa_mxl
//   Set, clear, write misa.MXL.  Should not change
/////////////////////////////////

# Save misa
  csrr x15, misa      # save misa
80000040:	301027f3          	csrrs	x15,misa,x0
# Load 1s into msb and msb-1 corresponding to misa.MXL bitfields
  LI(x8, -1)           # all 1s
80000044:	fff00413          	addi	x8,x0,-1
  srli x8, x8, 1  # all 1s except msb = 0
80000048:	00145413          	srli	x8,x8,0x1
  not x8, x8      # 1 in msb (works regardless of XLEN)
8000004c:	fff44413          	xori	x8,x8,-1
  srli x14, x8, 1 # 1s in msb-1
