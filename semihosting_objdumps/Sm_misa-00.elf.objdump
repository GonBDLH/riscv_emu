80000040 <rvtest_code_begin>:
// cp_misa_mxl
//   Set, clear, write misa.MXL.  Should not change
/////////////////////////////////

# Save misa
  csrr x6, misa      # save misa
80000040:	30102373          	csrrs	x6,misa,x0
# Load 1s into msb and msb-1 corresponding to misa.MXL bitfields
  LI(x14, -1)           # all 1s
80000044:	fff00713          	addi	x14,x0,-1
  srli x14, x14, 1  # all 1s except msb = 0
80000048:	00175713          	srli	x14,x14,0x1
  not x14, x14      # 1 in msb (works regardless of XLEN)
8000004c:	fff74713          	xori	x14,x14,-1
  srli x9, x14, 1 # 1s in msb-1
80000050:	00175493          	srli	x9,x14,0x1
  or x8, x14, x9 # 1s in both msb and msb-1
80000054:	00976433          	or	x8,x14,x9

