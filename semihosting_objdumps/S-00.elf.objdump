80000040 <rvtest_code_begin>:
//   Execute sret from S-mode while sweeping cross-product of sstatus.spp, spie, sie
//   Go to S or U mode depending on SPP.  SIE <- SPIE.  SPIE <- 1.  MPRV <- 0. SPP <- 0 (U-mode).
/////////////////////////////////

# Setup
  csrr x14, sstatus        # read and save sstatus
80000040:	10002773          	csrrs	x14,sstatus,x0
  # set up x8 with sstatus except SPP, SPIE, SIE cleared
  LI(x13, 0x122)          # x13 has all SPP, SPIE, SIE bits set (bits [8], [5], [1] respectively)
80000044:	12200693          	addi	x13,x0,290
  not x13, x13              # x13 has all but SPP, SPIE, SIE bits set
80000048:	fff6c693          	xori	x13,x13,-1
  and x8, x14, x13          # clear SPP, SPIE, SIE bits
8000004c:	00d77433          	and	x8,x14,x13

# Testcase: sret from s-mode with spp = 0, spie = 0, sie = 0
  LI(x9, 0x00000000) # spp = 0 spie = 0 sie = 0
80000050:	00000493          	addi	x9,x0,0
  or x9, x9, x8          # value to write to sstatus with SPP/SPIE/SIE bits set/clear
80000054:	0084e4b3          	or	x9,x9,x8
80000058:	00000013          	addi	x0,x0,0
8000005c:	00000013          	addi	x0,x0,0
  LA(x15, 1f)             # return address after sret
80000060:	00000797          	auipc	x15,0x0
80000064:	03078793          	addi	x15,x15,48 # 80000090 <S_sprivinst_cg_cp_sret_s_spp_0_spie_0_sie_0_wval+0x8>
80000068:	00000013          	addi	x0,x0,0
8000006c:	00000013          	addi	x0,x0,0
80000070:	00000013          	addi	x0,x0,0
80000074:	00000013          	addi	x0,x0,0
80000078:	00000013          	addi	x0,x0,0
8000007c:	00000013          	addi	x0,x0,0
  csrw sepc, x15          # set sepc to return address.
80000080:	14179073          	csrrw	x0,sepc,x15
  csrw sstatus, x9       # write sstatus with SPP/SPIE/SIE bits set/clear
80000084:	10049073          	csrrw	x0,sstatus,x9

