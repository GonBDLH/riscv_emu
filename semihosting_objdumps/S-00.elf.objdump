80000040 <rvtest_code_begin>:
//   Execute sret from S-mode while sweeping cross-product of sstatus.spp, spie, sie
//   Go to S or U mode depending on SPP.  SIE <- SPIE.  SPIE <- 1.  MPRV <- 0. SPP <- 0 (U-mode).
/////////////////////////////////

# Setup
  csrr x13, sstatus        # read and save sstatus
80000040:	100026f3          	csrrs	x13,sstatus,x0
  # set up x6 with sstatus except SPP, SPIE, SIE cleared
  LI(x14, 0x122)          # x14 has all SPP, SPIE, SIE bits set (bits [8], [5], [1] respectively)
80000044:	12200713          	addi	x14,x0,290
  not x14, x14              # x14 has all but SPP, SPIE, SIE bits set
80000048:	fff74713          	xori	x14,x14,-1
  and x6, x13, x14          # clear SPP, SPIE, SIE bits
8000004c:	00e6f333          	and	x6,x13,x14

# Testcase: sret from s-mode with spp = 0, spie = 0, sie = 0
  LI(x15, 0x00000000) # spp = 0 spie = 0 sie = 0
80000050:	00000793          	addi	x15,x0,0
  or x15, x15, x6          # value to write to sstatus with SPP/SPIE/SIE bits set/clear
80000054:	0067e7b3          	or	x15,x15,x6
80000058:	00000013          	addi	x0,x0,0
8000005c:	00000013          	addi	x0,x0,0
  LA(x8, 1f)             # return address after sret
80000060:	00000417          	auipc	x8,0x0
80000064:	03040413          	addi	x8,x8,48 # 80000090 <S_sprivinst_cg_cp_sret_s_spp_0_spie_0_sie_0_wval+0x8>
80000068:	00000013          	addi	x0,x0,0
8000006c:	00000013          	addi	x0,x0,0
80000070:	00000013          	addi	x0,x0,0
80000074:	00000013          	addi	x0,x0,0
80000078:	00000013          	addi	x0,x0,0
8000007c:	00000013          	addi	x0,x0,0
  csrw sepc, x8          # set sepc to return address.
80000080:	14141073          	csrrw	x0,sepc,x8
  csrw sstatus, x15       # write sstatus with SPP/SPIE/SIE bits set/clear
80000084:	10079073          	csrrw	x0,sstatus,x15

