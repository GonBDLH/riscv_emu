80000040 <rvtest_code_begin>:
/////////////////////////////////
// cp_imm_mul_addi16sp
/////////////////////////////////

# Testcase cp_imm_mul_addi16sp: imm=-512
  mv x10, x2 # switch signature pointer register to avoid conflict with test
80000040:	850a                	c.mv	x10,x2
  RVTEST_TESTDATA_LOAD_INT(x3, x2) # load rd/rs1: x2 = 0x6b51fd0a
80000042:	0001a103          	lw	x2,0(x3)
80000046:	0191                	c.addi	x3,4

80000048 <Zca_c_addi16sp_cg_cp_imm_mul_addi16sp_bm0x200>:
Zca_c_addi16sp_cg_cp_imm_mul_addi16sp_bm0x200:
  c.addi16sp x2, -512 # perform operation
