80000040 <rvtest_code_begin>:
// cp_mstatus_sd_write
//   Write all combinations of mstatus.SD = {0/1}, FS/XS/VS = {00, 01, 10, 11}
//   mstatus.SD is read-only, so nothing should happen
/////////////////////////////////

  SET_MSB(x6) # put a 1 in the msb of x6 (XLEN-1)
80000040:	80000337          	lui	x6,0x80000
  csrr x15, mstatus        # read and save mstatus
80000044:	300027f3          	csrrs	x15,mstatus,x0
  # set up x9 with mstatus except SD, FS, XS, VS cleared
  not x8, x6              # x8 has all but msb set
80000048:	fff34413          	xori	x8,x6,-1
  and x9, x15, x8 # clear SD bit
8000004c:	0087f4b3          	and	x9,x15,x8
  LI(x8, 0x1E600)              # x8 has all FS, XS, VS bits set (bits [14:13], [16:15], [10:9], respectively)
80000050:	0001e437          	lui	x8,0x1e
80000054:	60040413          	addi	x8,x8,1536 # 1e600 <absimm+0x1e400>
  not x8, x8              # x8 has all but FS, XS, VS bits set
80000058:	fff44413          	xori	x8,x8,-1
  and x9, x9, x8     # clear FS, XS, VS bits
8000005c:	0084f4b3          	and	x9,x9,x8

# fs = 00 xs = 00 vs = 00
  LI(x14, 0x00000000)
80000060:	00000713          	addi	x14,x0,0
  or x14, x14, x9   # value to write to mstatus with SD/FS/XS/VS bits set/clear
80000064:	00976733          	or	x14,x14,x9

