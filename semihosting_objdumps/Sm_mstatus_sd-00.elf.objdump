80000040 <rvtest_code_begin>:
// cp_mstatus_sd_write
//   Write all combinations of mstatus.SD = {0/1}, FS/XS/VS = {00, 01, 10, 11}
//   mstatus.SD is read-only, so nothing should happen
/////////////////////////////////

  SET_MSB(x14) # put a 1 in the msb of x14 (XLEN-1)
80000040:	80000737          	lui	x14,0x80000
  csrr x13, mstatus        # read and save mstatus
80000044:	300026f3          	csrrs	x13,mstatus,x0
  # set up x15 with mstatus except SD, FS, XS, VS cleared
  not x9, x14              # x9 has all but msb set
80000048:	fff74493          	xori	x9,x14,-1
  and x15, x13, x9 # clear SD bit
8000004c:	0096f7b3          	and	x15,x13,x9
  LI(x9, 0x1E600)              # x9 has all FS, XS, VS bits set (bits [14:13], [16:15], [10:9], respectively)
80000050:	0001e4b7          	lui	x9,0x1e
80000054:	60048493          	addi	x9,x9,1536 # 1e600 <absimm+0x1e400>
  not x9, x9              # x9 has all but FS, XS, VS bits set
80000058:	fff4c493          	xori	x9,x9,-1
  and x15, x15, x9     # clear FS, XS, VS bits
8000005c:	0097f7b3          	and	x15,x15,x9

# fs = 00 xs = 00 vs = 00
  LI(x6, 0x00000000)
80000060:	00000313          	addi	x6,x0,0
  or x6, x6, x15   # value to write to mstatus with SD/FS/XS/VS bits set/clear
80000064:	00f36333          	or	x6,x6,x15

