  jalr x1, 8(x9) # PC+8 jump target is PC + base_off + jalr_off (bit 0 cleared)
800000f0:	008480e7          	jalr	x1,8(x9)
# JALR target may land on the upper halfword (0x0001) of a padding ADDI, which decodes as a valid c.nop
