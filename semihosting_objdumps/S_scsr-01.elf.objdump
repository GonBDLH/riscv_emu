80000040 <rvtest_code_begin>:


# CSR Walk Tests for sscratch
  csrr x15, sscratch      # Save CSR
80000040:	140027f3          	csrrs	x15,sscratch,x0
  LI(x8, 1)              # 1 in bit 0
80000044:	00100413          	addi	x8,x0,1
  LI(x13, -1)             # x13 = all 1s
80000048:	fff00693          	addi	x13,x0,-1
  csrw sscratch, zero    # clear all bits
8000004c:	14001073          	csrrw	x0,sscratch,x0
  csrs sscratch, x8     # set walking 1 in column 0
80000050:	14042073          	csrrs	x0,sscratch,x8

80000054 <S_scsr_cg_cp_scsrwalk_sscratch_set_bit_0>:
