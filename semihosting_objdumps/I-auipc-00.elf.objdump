80000040 <rvtest_code_begin>:
// cp_rd
/////////////////////////////////

# Testcase cp_rd (Test destination rd = x0)
I_auipc_cg_cp_rd_b0:
  auipc x0, 190699 # perform operation
80000040:	2e8eb017          	auipc	x0,0x2e8eb
