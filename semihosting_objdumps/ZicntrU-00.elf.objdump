80000040 <rvtest_code_begin>:
// cp_mcounteren_access_u
//   If S_SUPPORTED, write scounteren = 1s.  Write walking 1s and 0s to mcounteren.  Read from corresponding counter and counterh in U-mode
/////////////////////////////////

#ifdef S_SUPPORTED
  LI(x13, -1)
80000040:	fff00693          	addi	x13,x0,-1
  # T-SBI call to execute instruction: csrw scounteren, x13  # enable all counters for U-mode
  # Copy rs1 (x13) to a1 for T-SBI call
  mv a1, x13
