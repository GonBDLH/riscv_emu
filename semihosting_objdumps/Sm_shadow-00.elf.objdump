80000040 <rvtest_code_begin>:
// cp_shadow
//   Check that values written to shadowed registers are consistent between machine and supervisor mode
/////////////////////////////////

#ifdef S_SUPPORTED
  LI(x8, 0x007FFFBF) # skip UBE, UXL bits which would cause weird behavior
80000040:	00800437          	lui	x8,0x800
80000044:	fbf40413          	addi	x8,x8,-65 # 7fffbf <STACK_SIZE+0x7dffbf>

# Testcase: shadow CSR test for writing mstatus and reading sstatus with mask 0xcffffffcf
  LI(x9, 0xcffffffcf) # mask specifying bits to keep
80000048:	fcf00493          	addi	x9,x0,-49
  csrr x14, mstatus       # save original value of mstatus
8000004c:	30002773          	csrrs	x14,mstatus,x0
  csrw mstatus, x8       # write many 1s to mstatus
