80000040 <rvtest_code_begin>:
// cp_shadow
//   Check that values written to shadowed registers are consistent between machine and supervisor mode
/////////////////////////////////

#ifdef S_SUPPORTED
  LI(x15, 0x007FFFBF) # skip UBE, UXL bits which would cause weird behavior
80000040:	008007b7          	lui	x15,0x800
80000044:	fbf78793          	addi	x15,x15,-65 # 7fffbf <STACK_SIZE+0x7dffbf>

# Testcase: shadow CSR test for writing mstatus and reading sstatus with mask 0xcffffffcf
  LI(x14, 0xcffffffcf) # mask specifying bits to keep
80000048:	fcf00713          	addi	x14,x0,-49
  csrr x13, mstatus       # save original value of mstatus
8000004c:	300026f3          	csrrs	x13,mstatus,x0
  csrw mstatus, x15       # write many 1s to mstatus
