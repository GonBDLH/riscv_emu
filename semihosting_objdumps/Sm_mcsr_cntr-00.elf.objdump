80000040 <rvtest_code_begin>:
// cp_cntr_access
//   Read, write nonzero, write all 0s, set nonzero, set all 0s, restore all M-mode counters
/////////////////////////////////

# Counter Access Tests for mcycle
  csrr x14, mcycle    # Save CSR
80000040:	b0002773          	csrrs	x14,mcycle,x0
#if __riscv_xlen == 64
  LI(x15, 0x123456789ABCFFFF)   # x15 = 64-bit pattern
#else
  LI(x15, 0x1234FFFF)           # x15 = 32-bit pattern
80000044:	123507b7          	lui	x15,0x12350
80000048:	fff78793          	addi	x15,x15,-1 # 1234ffff <RAM_LENGTH+0xa34ffff>

8000004c <Sm_mcsr_cg_cp_cntr_access_mcycle_csrrw_some>:
#endif
Sm_mcsr_cg_cp_cntr_access_mcycle_csrrw_some:
  csrw mcycle, x15     # Write nonzero to CSR
8000004c:	b0079073          	csrrw	x0,mcycle,x15
  csrr x6, mcycle    # Read back CSR to check
80000050:	b0002373          	csrrs	x6,mcycle,x0
  sub x6, x6, x15   # Difference between read value and written value
80000054:	40f30333          	sub	x6,x6,x15
  sltiu x6, x6, 0x000007FF  # Check difference < 0x7FF to allow for counter increments
80000058:	7ff33313          	sltiu	x6,x6,2047
  # Check if x6 contains the expected result. x2 is the signature ptr, x5 is the link ptr, x4 is a temp reg.
  RVTEST_SIGUPD(x2, x5, x4, x6, Sm_mcsr_cg_cp_cntr_access_mcycle_csrrw_some, Sm_mcsr_cg_cp_cntr_access_mcycle_csrrw_some_str)
