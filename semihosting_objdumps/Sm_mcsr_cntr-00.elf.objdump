80000040 <rvtest_code_begin>:
// cp_cntr_access
//   Read, write nonzero, write all 0s, set nonzero, set all 0s, restore all M-mode counters
/////////////////////////////////

# Counter Access Tests for mcycle
  csrr x6, mcycle    # Save CSR
80000040:	b0002373          	csrrs	x6,mcycle,x0
#if __riscv_xlen == 64
  LI(x14, 0x123456789ABCFFFF)   # x14 = 64-bit pattern
#else
  LI(x14, 0x1234FFFF)           # x14 = 32-bit pattern
80000044:	12350737          	lui	x14,0x12350
80000048:	fff70713          	addi	x14,x14,-1 # 1234ffff <RAM_LENGTH+0xa34ffff>

8000004c <Sm_mcsr_cg_cp_cntr_access_mcycle_csrrw_some>:
#endif
Sm_mcsr_cg_cp_cntr_access_mcycle_csrrw_some:
  csrw mcycle, x14     # Write nonzero to CSR
8000004c:	b0071073          	csrrw	x0,mcycle,x14
  csrr x13, mcycle    # Read back CSR to check
80000050:	b00026f3          	csrrs	x13,mcycle,x0
  sub x13, x13, x14   # Difference between read value and written value
80000054:	40e686b3          	sub	x13,x13,x14
  sltiu x13, x13, 0x000007FF  # Check difference < 0x7FF to allow for counter increments
80000058:	7ff6b693          	sltiu	x13,x13,2047
  # Check if x13 contains the expected result. x2 is the signature ptr, x5 is the link ptr, x4 is a temp reg.
  RVTEST_SIGUPD(x2, x5, x4, x13, Sm_mcsr_cg_cp_cntr_access_mcycle_csrrw_some, Sm_mcsr_cg_cp_cntr_access_mcycle_csrrw_some_str)
