80000040 <rvtest_code_begin>:

// RV32-only h CSRs
#if __riscv_xlen == 32

# CSR Walk Tests for mstatush
  csrr x14, mstatush      # Save CSR
80000040:	31002773          	csrrs	x14,0x310,x0
  LI(x15, 1)              # 1 in bit 0
80000044:	00100793          	addi	x15,x0,1
  LI(x13, 704)    # Load mask (0x2c0)
80000048:	2c000693          	addi	x13,x0,704
  LI(x8, -1)             # x8 = all 1s
8000004c:	fff00413          	addi	x8,x0,-1
  csrw mstatush, zero    # clear all bits
80000050:	31001073          	csrrw	x0,0x310,x0
  and x9, x15, x13 # mask walking 1
80000054:	00d7f4b3          	and	x9,x15,x13
  csrs mstatush, x9     # set walking 1 in column 0
80000058:	3104a073          	csrrs	x0,0x310,x9

