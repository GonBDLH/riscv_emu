80000040 <rvtest_code_begin>:




# CSR Walk Tests for mstatus
  csrr x8, mstatus      # Save CSR
80000040:	30002473          	csrrs	x8,mstatus,x0
  LI(x13, 1)              # 1 in bit 0
80000044:	00100693          	addi	x13,x0,1
  LI(x6, 9223374238042292138)    # Load mask (0x8000020080ffffaa)
80000048:	81000337          	lui	x6,0x81000
8000004c:	faa30313          	addi	x6,x6,-86 # 80ffffaa <_end+0xfbcfaa>
  LI(x9, -1)             # x9 = all 1s
80000050:	fff00493          	addi	x9,x0,-1
  csrw mstatus, zero    # clear all bits
80000054:	30001073          	csrrw	x0,mstatus,x0
  and x14, x13, x6 # mask walking 1
80000058:	0066f733          	and	x14,x13,x6
  csrs mstatus, x14     # set walking 1 in column 0
8000005c:	30072073          	csrrs	x0,mstatus,x14

