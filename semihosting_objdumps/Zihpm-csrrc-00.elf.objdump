80000040 <rvtest_code_begin>:
// cp_cntr_hpm
/////////////////////////////////

# Testcase: cp_cntr (hpmcounter3)
# Read two consecutive times to check if counter increments
  csrrc x18, hpmcounter3, x0
80000040:	c0303973          	csrrc	x18,hpmcounter3,x0
  addi x12, x18, 1 # delay a bit
80000044:	00190613          	addi	x12,x18,1
  addi x12, x12, 1 # delay a bit
80000048:	00160613          	addi	x12,x12,1
  addi x12, x12, 1 # delay a bit
8000004c:	00160613          	addi	x12,x12,1
  addi x12, x12, 1 # delay a bit
80000050:	00160613          	addi	x12,x12,1
  addi x12, x12, 1 # delay a bit
80000054:	00160613          	addi	x12,x12,1
  addi x12, x12, 1 # delay a bit
80000058:	00160613          	addi	x12,x12,1
  csrrc x12, hpmcounter3, x0
8000005c:	c0303673          	csrrc	x12,hpmcounter3,x0

80000060 <Zihpm_csrrc_cg_cp_cntr_hpmcounter3>:
Zihpm_csrrc_cg_cp_cntr_hpmcounter3:
  csrrc x12, hpmcounter3, x0 # read again to increase delay a bit more
80000060:	c0303673          	csrrc	x12,hpmcounter3,x0
  sub x18, x12, x18 # compute difference
80000064:	41260933          	sub	x18,x12,x18
  slti x18, x18, 0 # set fail code if difference < 0
80000068:	00092913          	slti	x18,x18,0
  # Check if x18 contains the expected result. x2 is the signature ptr, x5 is the link ptr, x4 is a temp reg.
  RVTEST_SIGUPD(x2, x5, x4, x18, Zihpm_csrrc_cg_cp_cntr_hpmcounter3, Zihpm_csrrc_cg_cp_cntr_hpmcounter3_str)
