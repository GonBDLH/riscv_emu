80000040 <rvtest_code_begin>:
// cp_cntr_hpm
/////////////////////////////////

# Testcase: cp_cntr (hpmcounter3)
# Read two consecutive times to check if counter increments
  csrrs x12, hpmcounter3, x0
80000040:	c0302673          	csrrs	x12,hpmcounter3,x0
  addi x21, x12, 1 # delay a bit
80000044:	00160a93          	addi	x21,x12,1
  addi x21, x21, 1 # delay a bit
80000048:	001a8a93          	addi	x21,x21,1
  addi x21, x21, 1 # delay a bit
8000004c:	001a8a93          	addi	x21,x21,1
  addi x21, x21, 1 # delay a bit
80000050:	001a8a93          	addi	x21,x21,1
  addi x21, x21, 1 # delay a bit
80000054:	001a8a93          	addi	x21,x21,1
  addi x21, x21, 1 # delay a bit
80000058:	001a8a93          	addi	x21,x21,1
  csrrs x21, hpmcounter3, x0
8000005c:	c0302af3          	csrrs	x21,hpmcounter3,x0

80000060 <Zihpm_csrrs_cg_cp_cntr_hpmcounter3>:
Zihpm_csrrs_cg_cp_cntr_hpmcounter3:
  csrrs x21, hpmcounter3, x0 # read again to increase delay a bit more
80000060:	c0302af3          	csrrs	x21,hpmcounter3,x0
  sub x12, x21, x12 # compute difference
80000064:	40ca8633          	sub	x12,x21,x12
  slti x12, x12, 0 # set fail code if difference < 0
