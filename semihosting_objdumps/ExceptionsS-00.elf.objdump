80000040 <rvtest_code_begin>:
// cp_instr_adr_misaligned_jal
//   Instruction Address Misaligned JAL
/////////////////////////////////
  .p2align 2
ExceptionsS_cg_cp_instr_adr_misaligned_jal_jal_misaligned:
  jal x0, .+6
80000040:	0060006f          	jal	x0,80000046 <rvtest_code_begin+0x6>
# branch by 6 lands in upper half of next instruction 0x0001 which is generated into a c.nop
  addi x0, x2, 0
80000044:	00010013          	addi	x0,x2,0
  nop
80000048:	00000013          	addi	x0,x0,0
//   Instruction Address Misaligned JALR
/////////////////////////////////

# rs1[1:0]=00, offset[1:0]=00
  .p2align 2
  auipc x6, 0 # PC+0 addr_reg = PC
8000004c:	00000317          	auipc	x6,0x0
  addi x6, x6, 8 # PC+4 addr_reg[1:0] = rs1_lsb
80000050:	00830313          	addi	x6,x6,8 # 80000054 <ExceptionsS_cg_cp_instr_adr_misaligned_jalr_jalr_rs1_0_off_0>

