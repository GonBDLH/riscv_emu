80000040 <rvtest_code_begin>:
/////////////////////////////////
// cp_mret
//   Execute mret while sweeping cross-product of mpp, mprv, mpie, mie
/////////////////////////////////

  csrr x9, mstatus        # read and save mstatus
80000040:	300024f3          	csrrs	x9,mstatus,x0
  # set up x14 with mstatus except MPP, MPRV, MPIE, MIE cleared
  LI(x15, 0x21888)          # x15 has all MPP, MPRV, MPIE, MIE bits set (bits [12:11], [17], [7], [3], respectively)
80000044:	000227b7          	lui	x15,0x22
80000048:	88878793          	addi	x15,x15,-1912 # 21888 <STACK_SIZE+0x1888>
  not x15, x15              # x15 has all but MPP, MPRV, MPIE, MIE bits set
8000004c:	fff7c793          	xori	x15,x15,-1
  and x14, x9, x15         # clear MPP, MPRV, MPIE, MIE bits
80000050:	00f4f733          	and	x14,x9,x15

# mret with mpp = 11 mprv = 0 mpie = 0 mie = 0
  LI(x6, 0x00001800)
