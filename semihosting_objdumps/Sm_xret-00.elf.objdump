80000058:	80030313          	addi	x6,x6,-2048 # 1800 <absimm+0x1600>
  or x6, x6, x14         # value to write to mstatus with MPP/MPRV/MPIE/MIE bits set/clear
8000005c:	00e36333          	or	x6,x6,x14
  LA(x8, 1f)              # return address after mret
