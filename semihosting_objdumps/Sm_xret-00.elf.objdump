80000040 <rvtest_code_begin>:
/////////////////////////////////
// cp_mret
//   Execute mret while sweeping cross-product of mpp, mprv, mpie, mie
/////////////////////////////////

  csrr x15, mstatus        # read and save mstatus
80000040:	300027f3          	csrrs	x15,mstatus,x0
  # set up x13 with mstatus except MPP, MPRV, MPIE, MIE cleared
  LI(x6, 0x21888)          # x6 has all MPP, MPRV, MPIE, MIE bits set (bits [12:11], [17], [7], [3], respectively)
80000044:	00022337          	lui	x6,0x22
80000048:	88830313          	addi	x6,x6,-1912 # 21888 <STACK_SIZE+0x1888>
  not x6, x6              # x6 has all but MPP, MPRV, MPIE, MIE bits set
8000004c:	fff34313          	xori	x6,x6,-1
  and x13, x15, x6         # clear MPP, MPRV, MPIE, MIE bits
80000050:	0067f6b3          	and	x13,x15,x6

# mret with mpp = 11 mprv = 0 mpie = 0 mie = 0
  LI(x14, 0x00001800)
