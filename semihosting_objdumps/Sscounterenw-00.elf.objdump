80000040 <rvtest_code_begin>:
//   Set and clear each bit individually in scounteren.
/////////////////////////////////


# CSR Walk Tests for scounteren
  csrr x13, scounteren      # Save CSR
80000040:	106026f3          	csrrs	x13,scounteren,x0
  LI(x15, 1)              # 1 in bit 0
80000044:	00100793          	addi	x15,x0,1
  LI(x14, -1)             # x14 = all 1s
80000048:	fff00713          	addi	x14,x0,-1
  csrw scounteren, zero    # clear all bits
8000004c:	10601073          	csrrw	x0,scounteren,x0
  csrs scounteren, x15     # set walking 1 in column 0
80000050:	1067a073          	csrrs	x0,scounteren,x15

