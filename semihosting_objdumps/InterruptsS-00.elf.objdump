80000040 <rvtest_code_begin>:
#define SET_SSW_INT(_R1, _R2)  LI(_R1, 0x2);  csrs mip, _R1;
#define CLR_SSW_INT(_R1, _R2)  LI(_R1, 0x2);  csrc mip, _R1;
#define SET_SEXT_INT(_R1, _R2)  LI(_R1, 0x200);  csrs mip, _R1;
#define CLR_SEXT_INT(_R1, _R2)  LI(_R1, 0x200);  csrc mip, _R1;
# Initial setup - clear mideleg (no U-mode delegation)
  csrw mideleg, zero
80000040:	30301073          	csrrw	x0,mideleg,x0
  LI(x14, 0x200000) # Clear TW bit
80000044:	00200737          	lui	x14,0x200
  csrc mstatus, x14
80000048:	30073073          	csrrc	x0,mstatus,x14

# Cross: mideleg x SIE
# === M-MODE SETUP (safe order) ===

# M-mode setup
  csrw mie, zero # 1. Disable ALL interrupts first
8000004c:	30401073          	csrrw	x0,mie,x0
  csrci mstatus, 8 # 2. MIE=0
80000050:	30047073          	csrrci	x0,mstatus,8
  csrci mstatus, 2 # 3. SIE=0 (clear first)
80000054:	30017073          	csrrci	x0,mstatus,2
# Clear timers
  # Clear supervisor timer interrupt
  BEQZ x0, 1f # If STCE=0, use legacy method
80000058:	00000a63          	beq	x0,x0,8000006c <rvtest_code_begin+0x2c>

  # Sstc method: Write stimecmp = -1 (max value)
